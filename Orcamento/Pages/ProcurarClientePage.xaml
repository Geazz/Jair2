<Page x:Class="OrcamentoObra.Pages.ProcurarClientePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Procurar cliente">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Procurar cliente" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Margin="0,0,20,0">
            <TextBlock Text="Pesquisar por nome ou NIF"/>
            <TextBox x:Name="TxtPesquisa" Margin="0,0,0,8" TextChanged="Pesquisa_TextChanged"/>
            <ListBox x:Name="ListaClientes" Height="420" DisplayMemberPath="Nome"
                     SelectionChanged="ListaClientes_SelectionChanged"/>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="15">
            <StackPanel>
                <TextBlock Text="Detalhes do cliente" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtDetalhes" TextWrapping="Wrap" FontSize="14"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Voltar" Width="180" HorizontalAlignment="Left"
                Margin="0,15,0,0" Style="{StaticResource Botao}" Click="Voltar_Click"/>
    </Grid>
</Page>
