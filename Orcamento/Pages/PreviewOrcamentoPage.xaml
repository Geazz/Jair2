<Page x:Class="OrcamentoObra.Pages.PreviewOrcamentoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Orçamento">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Background="#EEEEEE" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ContentControl x:Name="Conteudo" HorizontalAlignment="Center" Margin="20"/>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button Content="Imprimir / PDF" Width="180" Style="{StaticResource Botao}" Click="Imprimir_Click"/>
            <Button x:Name="BtnSalvar" Content="Salvar orçamento" Width="180" Style="{StaticResource Botao}" Click="Salvar_Click"/>
            <Button Content="Voltar à home" Width="180" Style="{StaticResource Botao}" Click="Home_Click"/>
        </StackPanel>
    </Grid>
</Page>
