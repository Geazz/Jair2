<Page x:Class="OrcamentoObra.Pages.NovoOrcamentoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Novo orçamento">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30" MaxWidth="800">
            <TextBlock Text="Fazer orçamento" FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Número do orçamento *"/>
                    <TextBox x:Name="TxtNumero" IsReadOnly="True" Margin="0,0,0,8"/>
                    <TextBlock Text="Data *"/>
                    <DatePicker x:Name="DpData" Margin="0,0,0,8"/>
                    <TextBlock Text="Cliente *"/>
                    <ComboBox x:Name="CmbCliente" Margin="0,0,0,8"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Validade *"/>
                    <DatePicker x:Name="DpValidade" Margin="0,0,0,8"/>
                    <TextBlock Text="Localidade *"/>
                    <TextBox x:Name="TxtLocalidade" Margin="0,0,0,8"/>
                    <TextBlock Text="IVA *"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <RadioButton x:Name="RbComIva" GroupName="Iva" Content="Com IVA" Margin="0,0,15,0"
                                     Checked="RbIva_Changed" Unchecked="RbIva_Changed"/>
                        <RadioButton x:Name="RbSemIva" GroupName="Iva" Content="Sem IVA"/>
                    </StackPanel>
                    <TextBlock Text="Percentagem do IVA (%) *"/>
                    <TextBox x:Name="TxtPercIva" IsEnabled="False" Margin="0,0,0,8"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Descrição da obra *"/>
            <TextBox x:Name="TxtDescricao" Height="80" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" Margin="0,0,0,15"/>

            <TextBlock Text="Itens" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Qtd. *"/>
                    <TextBox x:Name="TxtQtd"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Preço unit. (€) *"/>
                    <TextBox x:Name="TxtPrecoUnit"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Descrição do item *"/>
                    <TextBox x:Name="TxtDescItem"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Adicionar item" Width="150" VerticalAlignment="Bottom"
                        Style="{StaticResource Botao}" Click="AdicionarItem_Click"/>
            </Grid>

            <DataGrid x:Name="GridItens" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" Height="180" Margin="0,0,0,8">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Qtd." Binding="{Binding Quantidade}" Width="70"/>
                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                    <DataGridTextColumn Header="Preço unit." Binding="{Binding PrecoUnitario, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="Preço total" Binding="{Binding PrecoTotal, StringFormat=C2}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Remover item selecionado" Width="200" HorizontalAlignment="Left"
                    Style="{StaticResource Botao}" Click="RemoverItem_Click"/>

            <TextBlock x:Name="LblTotais" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right"
                       Margin="0,10,0,15" Text="Subtotal: 0,00 €"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Pré-visualizar" Width="180" Style="{StaticResource Botao}" Click="Continuar_Click"/>
                <Button Content="Voltar" Width="180" Style="{StaticResource Botao}" Click="Voltar_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
